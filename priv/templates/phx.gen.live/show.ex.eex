defmodule <%= inspect context.web_module %>.<%= inspect Module.concat(schema.web_namespace, schema.alias) %>Live.Show do
  use <%= inspect context.web_module %>, :live_view

  alias <%= inspect context.module %>

  @impl true
  def render(assigns) do
    ~H"""
    <.header>
      {dgettext("<%= schema.plural %>", "Show <%= schema.human_singular %>")}
      <:actions>
        <.button navigate={~p"<%= schema.route_prefix %>"} variant="secondary">
          <.icon name="fa-solid fa-arrow-left" /> {gettext("Back")}
        </.button>
        <.button navigate={~p"<%= schema.route_prefix %>/#{@<%= schema.singular %>}/edit?return_to=show"}>
          <.icon name="fa-solid fa-pencil" /> {gettext("Edit")}
        </.button>
      </:actions>
    </.header>

    <.list><%= for {k, _} <- schema.attrs do %>
      <:item title={dgettext("<%= schema.plural %>", "<%= Phoenix.Naming.humanize(Atom.to_string(k)) %>")}>{@<%= schema.singular %>.<%= k %>}</:item><% end %>
    </.list>
    """
  end

  @impl true
  def mount(%{"<%= primary_key %>" => <%= primary_key %>}, _session, socket) do
    {:ok,
     socket
     |> assign(:page_title, dgettext("<%= schema.plural %>", "Show <%= schema.human_singular %>"))
     |> assign(:<%= schema.singular %>, <%= inspect context.alias %>.get_<%= schema.singular %>!(<%= primary_key %>))}
  end
end
