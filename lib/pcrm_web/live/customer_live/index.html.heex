<.header>
  {dgettext("customers", "Listing Customers")}
  <:actions>
    <.link patch={~p"/customers/new"}>
      <.button>{dgettext("customers", "New Customer")}</.button>
    </.link>
  </:actions>
</.header>

<.modal
  :if={@live_action in [:new, :edit]}
  id="customer-modal"
  show
  on_cancel={JS.patch(~p"/customers")}
>
  <.live_component
    module={PcrmWeb.CustomerLive.FormComponent}
    id={@customer.id || :new}
    title={@page_title}
    action={@live_action}
    customer={@customer}
    return_to={~p"/customers"}
  />
</.modal>

<div class="mt-8 overflow-x-auto">
  <table class="w-full text-sm text-left text-gray-700">
    <thead class="text-xs text-gray-500 uppercase border-b border-gray-200">
      <tr>
        <th class="py-3 pr-6 font-medium">{dgettext("customers", "Honorific Prefix")}</th>
        <th class="py-3 pr-6 font-medium">{dgettext("customers", "Given name")}</th>
        <th class="py-3 pr-6 font-medium">{dgettext("customers", "Family name")}</th>
        <th class="py-3 pr-6 font-medium">{dgettext("customers", "Honorific Suffix")}</th>
        <th class="py-3"></th>
      </tr>
    </thead>
    <tbody id="customers" class="divide-y divide-gray-100">
      <tr :for={customer <- @customers} id={"customer-#{customer.id}"} class="hover:bg-gray-50">
        <td class="py-3 pr-6">{customer.honorific_prefix}</td>
        <td class="py-3 pr-6">{customer.given_name}</td>
        <td class="py-3 pr-6">{customer.family_name}</td>
        <td class="py-3 pr-6">{customer.honorific_suffix}</td>
        <td class="py-3 flex items-center gap-3">
          <.link navigate={~p"/customers/#{customer.id}"} class="text-blue-600 hover:text-blue-500">
            {gettext("Show")}
          </.link>
          <.link patch={~p"/customers/#{customer.id}/edit"} class="text-blue-600 hover:text-blue-500">
            {gettext("Edit")}
          </.link>
          <.link
            phx-click="delete"
            phx-value-id={customer.id}
            data-confirm={gettext("Are you sure?")}
            class="text-red-600 hover:text-red-500 cursor-pointer"
          >
            {gettext("Delete")}
          </.link>
        </td>
      </tr>
    </tbody>
  </table>
</div>
